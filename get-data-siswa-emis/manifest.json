{
  "manifest_version": 3,
  "name": "EMIS Data Siswa Scraper",
  "version": "2.0.0",
  "description": "Ekstensi Auto-Record Data Siswa EMIS Kemenag saat membuka detail siswa",
  "permissions": [
    "activeTab",
    "sidePanel",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://emis.kemenag.go.id/*"
  ],
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://emis.kemenag.go.id/*"],
      "js": ["interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://emis.kemenag.go.id/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["interceptor.js"],
      "matches": ["https://emis.kemenag.go.id/*"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "EMIS Data Siswa Scraper"
  }
}
